{
  "lineWidth": 100,
  "markdown": { "lineWidth": 80, "textWrap": "always", "emphasisKind": "asterisks", "strongKind": "asterisks" },
  "yaml": { "braceSpacing": false, "quotes": "preferDouble", "trailingComma": false },
  "json": { "lineWidth": 160, "trailingCommas": "never", "object.preferSingleLine": true, "array.preferSingleLine": true },
  "ruff": { "quoteStyle": "double" },
  "includes": ["**/*.{md,yml,yaml,json,jsonc,py,css,js}"],
  "excludes": [
    "**/target/**",
    "docs/book/**",
    "docs/theme/**",
    "docs/mermaid.min.js",
    "**/*.min.js",
    "**/*.min.css",
    "fuzz/corpus/**",
    "**/benches/**/results/**"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.24.0.wasm",
    "https://plugins.dprint.dev/json-0.24.0.wasm",
    "https://plugins.dprint.dev/ruff-0.8.8.wasm",
    "https://plugins.dprint.dev/typescript-0.96.1.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
    "https://plugins.dprint.dev/g-plane/malva-v0.16.0.wasm"
  ]
}

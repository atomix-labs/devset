# The README's demo on a dark page; parts/demo.tape is the session. From the repository's root:
# vhs docs/demo/demo-dark.tape
Output docs/src/media/demo-dark.gif

Set Shell "bash"
Set FontFamily "JetBrains Mono, JetBrainsMono Nerd Font, DejaVu Sans Mono"
Set FontSize 20
Set LineHeight 1.35
Set Columns 96
Set Rows 19
Set Padding 32
Set Theme "GitHub Dark"
Set TypingSpeed 35ms
Set CursorBlink false

Source docs/demo/parts/demo.tape

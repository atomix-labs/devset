# What git leaves out. Each profile ignores its own output in a block of its own; the
# repository adds its own lines outside them.

# >>> devset: cargo-profiles >>>
*.profraw
perf.data*
flamegraph.svg
# <<< devset: cargo-profiles <<<

# >>> devset: cargo-workspace >>>
target/
**/*.rs.bk
*.pdb
# <<< devset: cargo-workspace <<<

# >>> devset: git-ignore >>>
# Local state: Claude Code's per-developer settings, notes. Its shared settings, hooks and skills
# are committed.
.claude/settings.local.json
/.mcp.json
/.annotations.json
.notes/
.notes.local.md
# Editors: the shared VS Code settings are committed, the rest is each developer's.
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
Thumbs.db
# Secrets: never committed; an .env.example template is.
.env
.env.*
!.env.example
*.pem
*.key
/.secrets/
# <<< devset: git-ignore <<<

# >>> devset: markdown >>>
/.rumdl_cache/
# <<< devset: markdown <<<

# >>> devset: mdbook >>>
/docs/book/
# Where the API preprocessor links the API into the book's source as it builds.
/docs/src/api
# <<< devset: mdbook <<<

# >>> devset: python >>>
__pycache__/
# <<< devset: python <<<

# >>> devset: cargo-binaries >>>
/dist/
# <<< devset: cargo-binaries <<<

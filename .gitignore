# >>> devset: gitignore >>>
# Local state: tools' caches, Claude Code's per-developer settings, notes.
/.rumdl_cache/
__pycache__/
.claude/*
!.claude/skills/
!.claude/settings.local.json.example
/.mcp.json
/.annotations.json
.notes/
.notes.local.md
# Editors: the shared VS Code settings are committed, the rest is each developer's.
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
Thumbs.db
# Secrets: never committed; an .env.example template is.
.env
.env.*
!.env.example
*.pem
*.key
/.secrets/
# <<< devset: gitignore <<<

# >>> devset: gitignore-rust >>>
target/
**/*.rs.bk
*.pdb
*.profraw
perf.data*
flamegraph.svg
# <<< devset: gitignore-rust <<<
# devset's own Claude Code settings, shared by everyone who works on it.
!.claude/settings.json

# >>> devset: mdbook >>>
/docs/book/
# <<< devset: mdbook <<<

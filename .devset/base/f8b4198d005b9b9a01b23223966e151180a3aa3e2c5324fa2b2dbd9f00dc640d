# Records the demos again from docs/demo/*.tape, each a terminal session VHS plays and films, and
# opens a pull request with the recordings that changed, labelled and assigned: on each release's
# tag, and on demand. With the vhs feature `merge`, `demo.merge` in .github/automation.json, it
# merges once every tape has played. A tape whose output no longer comes fails here, on its Wait
# lines, rather than going stale. The tag, not the GitHub Release: a release the workflow token
# publishes starts no other workflow.
#
# With the automation's GitHub App (`BUMP_APP_ID`, `BUMP_APP_KEY`), which the weekly bump uses too,
# the pull request runs the repository's checks, and GitHub's auto-merge merges it once they pass:
# the way through a default branch whose rules require them.
name: demo

on:
  push:
    tags: ["v*"]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: demo
  cancel-in-progress: true

jobs:
  record:
    # VHS drives Chrome, which GitHub's runner has; its action installs ttyd for x86-64 only.
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: write
      issues: write
      pull-requests: write
    steps:
      - id: app
        if: vars.BUMP_APP_ID != ''
        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0
        with:
          app-id: ${{ vars.BUMP_APP_ID }}
          private-key: ${{ secrets.BUMP_APP_KEY }}
          # Only what the demo does: its commit, its pull request, and the comments on it.
          permission-contents: write
          permission-issues: write
          permission-pull-requests: write
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      # mise alone: a release run restores no cache that another ref wrote, and the tools come next.
      - uses: jdx/mise-action@c2a87611a18de5b3828c5652fe268e992400cb5c # v4.3.0
        with:
          version: 2026.9.13
          install: false
          cache: false
      # Every locked tool mise downloads, checked against the lock, so a tape runs the repository's
      # own commands; those cargo builds from source are the checks' own, and no tape waits on them.
      - run: |
          mapfile -t tools < <(mise ls --current --json | jq -r 'keys[] | select(startswith("cargo:") | not)')
          if ((${#tools[@]})); then mise install --locked "${tools[@]}"; fi
          mise bin-paths >> "$GITHUB_PATH"
      # VHS, with ttyd, ffmpeg and JetBrains Mono.
      - uses: charmbracelet/vhs-action@f6d7db07a432fcd3b06772628d36a57f96d95dcf # v2.1.1
        with:
          version: v0.12.1
      - name: Record
        run: for tape in docs/demo/*.tape; do vhs -q "$tape"; done
      - uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        env:
          APP: ${{ steps.app.outputs.token != '' }}
        with:
          # GitHub's API answers a 5xx now and then: each request is tried three more times.
          retries: 3
          github-token: ${{ steps.app.outputs.token || github.token }}
          script: |
            const demo = require(`${process.env.GITHUB_WORKSPACE}/.github/scripts/demo.js`)
            await demo({ github, context, core, exec })

# The release's static musl builds on Linux, which run on any distribution; mise's lock keeps the
# asset each platform takes.
[tools."github:taiki-e/cargo-hack"]
version = "0.6.45"

[tools."github:taiki-e/cargo-hack".platforms]
linux-x64   = { asset_pattern = "cargo-hack-x86_64-unknown-linux-musl.tar.gz" }
linux-arm64 = { asset_pattern = "cargo-hack-aarch64-unknown-linux-musl.tar.gz" }

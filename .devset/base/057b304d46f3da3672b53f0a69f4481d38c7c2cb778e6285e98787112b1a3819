# git-cliff writes the changelog from Conventional Commits: https://git-cliff.org/docs/configuration

[changelog]
header = """
# Changelog

Every release, newest first, written by [git-cliff](https://git-cliff.org) from the commits.
[BREAKING-CHANGES.md](BREAKING-CHANGES.md) says how to move across a breaking change.
"""
body = """
{%- if version %}
## [{{ version | trim_start_matches(pat="v") }}](https://github.com/atomix-labs/devset/releases/tag/{{ version }}) - {{ timestamp | date(format="%Y-%m-%d") }}
{%- else %}
## [Unreleased]
{%- endif %}
{% for group, commits in commits | group_by(attribute="group") %}
### {{ group | striptags | trim }}
{% for commit in commits %}
- [{{ commit.id | truncate(length=7, end="") }}](https://github.com/atomix-labs/devset/commit/{{ commit.id }}) \
  {% if commit.scope %}*({{ commit.scope }})* {% endif %}{{ commit.message | upper_first | trim }}\
  {% if commit.breaking %} **breaking**{% endif %}
{%- endfor %}
{% endfor %}
{%- if version and previous.version %}
**Full Changelog**: <https://github.com/atomix-labs/devset/compare/{{ previous.version }}...{{ version }}>
{% endif %}
"""
trim = true

[git]
conventional_commits     = true
filter_unconventional    = true
split_commits            = false
protect_breaking_commits = true
filter_commits           = true
tag_pattern              = "v[0-9]*"
sort_commits             = "newest"

# The number GitHub adds to a squashed pull request's subject links to the pull request.
commit_preprocessors = [
    { pattern = '\(#([0-9]+)\)', replace = "([#${1}](https://github.com/atomix-labs/devset/pull/${1}))" },
]

# The group each commit falls in, in the order a release lists them; a release commit is left out.
commit_parsers = [
    { message = "^chore\\(release\\)", skip = true },
    { message = "^feat", group = "<!-- 0 -->Features" },
    { message = "^fix", group = "<!-- 1 -->Bug Fixes" },
    { message = "^perf", group = "<!-- 2 -->Performance" },
    { message = "^chore\\(bump\\)", group = "<!-- 3 -->Pins" },
    { message = "^ci\\(deps\\)", group = "<!-- 3 -->Pins" },
    { message = "^refactor", group = "<!-- 4 -->Refactor" },
    { message = "^docs", group = "<!-- 5 -->Documentation" },
    { message = "^ci", group = "<!-- 6 -->CI" },
    { message = "^(chore|build|style|test|revert)", group = "<!-- 7 -->Miscellaneous" },
]

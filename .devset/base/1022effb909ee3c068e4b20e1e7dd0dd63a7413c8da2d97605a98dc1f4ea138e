# Runs every `check-*` recipe on every change, each a job of its own, with the tools mise locks. The
# jobs are read from the justfile, so every check a checkout runs with `just check` runs here too;
# `check` is the one job to require. The site one recipe builds, named by `pages` in
# .github/automation.json, is kept from each run and deployed to Pages from the default branch.
name: check

on:
  push:
    branches: [main]
  pull_request:
  merge_group:

permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

env:
  MISE_LOCKED: "1"
  # One mise cache for a run: `plan` fills it with every locked tool, and each job after it restores
  # it, so a changed lock downloads and builds each tool once, not once a job.
  MISE_CACHE_KEY: "{{cache_key_prefix}}-{{platform}}-{{version}}-{{file_hash}}"
  # A job whose recipe runs cargo installs the toolchain; any other installs none, and where one
  # still runs cargo, the toolchain installs as it does.
  RUSTUP_AUTO_INSTALL: "1"

jobs:
  plan:
    # The jobs' own runner, whose image the cache is keyed by.
    runs-on: ${{ vars.CI_RUNNER || 'ubuntu-latest' }}
    timeout-minutes: 30
    outputs:
      recipes: ${{ steps.plan.outputs.recipes }}
      pages-recipe: ${{ steps.plan.outputs.pages-recipe }}
      pages-path: ${{ steps.plan.outputs.pages-path }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      # Every locked tool, into the cache the jobs restore.
      - uses: jdx/mise-action@7a4e45a543138629540c9a1616d08632b893e492 # v5.0.1
        with:
          version: 2026.9.13
          cache_key: ${{ env.MISE_CACHE_KEY }}
      - id: plan
        run: |
          # Each `check-*` recipe, and whether it runs cargo: `[metadata("rust")]` above it.
          recipes=$(just --dump --dump-format json | jq -c '
            [.recipes | to_entries[] | select(.key | startswith("check-"))
              | {recipe: .key, rust: ([.value.attributes[]? | objects | .metadata // empty | .[]]
                  | index("rust") != null)}]
            | sort_by(.recipe)')
          echo "recipes=$recipes" >> "$GITHUB_OUTPUT"
          settings=.github/automation.json
          [[ -f $settings ]] || exit 0
          recipe=$(jq -r '.pages.recipe // empty' "$settings")
          [[ -n $recipe ]] || exit 0
          if ! jq -e --arg recipe "$recipe" 'map(.recipe) | index($recipe)' <<< "$recipes" > /dev/null; then
            echo "::error file=$settings::pages.recipe names $recipe, which is no check recipe"
            exit 1
          fi
          path=$(jq -r '.pages.path // empty' "$settings")
          if [[ -z $path ]]; then
            echo "::error file=$settings::pages.path names the directory $recipe builds the site in"
            exit 1
          fi
          echo "pages-recipe=$recipe" >> "$GITHUB_OUTPUT"
          echo "pages-path=$path" >> "$GITHUB_OUTPUT"

  run:
    needs: plan
    if: needs.plan.outputs.recipes != '[]' && needs.plan.outputs.recipes != ''
    strategy:
      fail-fast: false
      matrix:
        include: ${{ fromJSON(needs.plan.outputs.recipes) }}
    name: ${{ matrix.recipe }}
    runs-on: ${{ vars.CI_RUNNER || 'ubuntu-latest' }}
    timeout-minutes: 120
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          # The whole history: check-git-commits reads a branch's commits, git-cliff the tags.
          fetch-depth: 0
      # Every locked tool, from the cache `plan` filled.
      - uses: jdx/mise-action@7a4e45a543138629540c9a1616d08632b893e492 # v5.0.1
        with:
          version: 2026.9.13
          cache_key: ${{ env.MISE_CACHE_KEY }}
      # The toolchain rust-toolchain.toml names, for a recipe that runs cargo, as `[metadata("rust")]`
      # says; rust-cache runs rustc to key its cache.
      - if: matrix.rust && hashFiles('rust-toolchain.toml') != ''
        run: rustup toolchain install
      # The build of a recipe that runs cargo, as `[metadata("rust")]` says, saved from the default
      # branch alone, which every pull request and merge group restores; not `~/.cargo/bin`, which
      # holds only the runner's own rustup. A job whose recipe runs no Rust tool starts no toolchain.
      - if: matrix.rust && hashFiles('Cargo.lock') != ''
        uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2.9.2
        with:
          key: ${{ matrix.recipe }}
          cache-bin: false
          save-if: ${{ github.ref == format('refs/heads/{0}', github.event.repository.default_branch) }}
      - env:
          RECIPE: ${{ matrix.recipe }}
        run: just "$RECIPE"
      # The site as checked: a pull request's is its preview, the default branch's is deployed.
      - if: matrix.recipe == needs.plan.outputs.pages-recipe
        uses: actions/upload-pages-artifact@fc324d3547104276b827a68afc52ff2a11cc49c9 # v5.0.0
        with:
          path: ${{ needs.plan.outputs.pages-path }}
          retention-days: ${{ github.event_name == 'pull_request' && 7 || 1 }}

  check:
    needs: [plan, run]
    if: always()
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - env:
          PLAN: ${{ needs.plan.result }}
          RUN: ${{ needs.run.result }}
        run: "[[ $PLAN == success && ($RUN == success || $RUN == skipped) ]]"

  deploy:
    needs: [plan, check]
    if: >-
      needs.plan.outputs.pages-recipe != '' && github.event_name == 'push'
      && github.ref_name == github.event.repository.default_branch
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      pages: write # create the deployment
      id-token: write # the token whose claims Pages checks
    environment:
      name: github-pages
      url: ${{ steps.deploy.outputs.page_url }}
    # One deploy at a time, and none cancelled halfway.
    concurrency:
      group: pages
      cancel-in-progress: false
    steps:
      - id: deploy
        uses: actions/deploy-pages@368f82528645a54fb793d4d04e342629a3f51346 # v5.0.1
